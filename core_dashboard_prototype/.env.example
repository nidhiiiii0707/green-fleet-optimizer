# Copy this file to .env.local (or .env) and fill in real values.
# Never commit an actual API key.

# Backend API base URL (defaults to http://127.0.0.1:8124 if unset)
VITE_API_URL=http://127.0.0.1:8124

# Google Maps JavaScript API key, used only as a map visualization layer
# (no Directions/Routes API calls — maritime routes are drawn from the
# optimizer's own real port coordinates and route assignments).
# Get one at https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=
